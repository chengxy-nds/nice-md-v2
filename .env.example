# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TiDB Cloud Serverless Connection URL (Optional)
# If set on Vercel environment variables or .env.local, the WEB client can
# sync without configuring credentials: the browser asks /api/tidb-proxy
# (server-side) instead of holding the password, so the server-side secret
# never reaches client JS in that path.
# BUT: credentials a user types into the web UI ARE stored in the browser
# (encrypted-at-rest by the secure-credentials layer, or by the OS keychain
# in the Electron app) and the browser connects to TiDB through the proxy
# with them. The "server-side only" promise applies to THIS env-var path
# only, not to user-entered configs.
# Example: mysql://username:password@gateway01.ap-northeast-1.prod.aws.tidbcloud.com:4000/easymd?ssl=true
TIDB_DATABASE_URL=""

# Alibaba Cloud OSS Image Hosting (Optional Server Default)
# If set on Vercel environment variables or .env.local, web client automatically uses this default OSS
# for image uploads without requiring users to configure client-side credentials.
# The Secret Key in THESE env vars stays server-side: signing happens in
# /api/oss-proxy and the key never reaches client JS.
# BUT: credentials a user types into the web UI (custom OSS) ARE stored in
# the browser (encrypted-at-rest by the secure-credentials layer, or by the
# OS keychain in the Electron app) and uploads are signed in the browser.
# The "server-side only" promise applies to THIS env-var path only.
# Users who configure custom OSS in the web UI will automatically override this default.
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""
OSS_BUCKET=""
OSS_ENDPOINT="oss-cn-beijing.aliyuncs.com"
OSS_DOMAIN="" # Optional: Custom CDN domain, e.g. https://firebook.oss-cn-beijing.aliyuncs.com
OSS_BASE_PATH="" # Optional: Folder prefix, e.g. images


