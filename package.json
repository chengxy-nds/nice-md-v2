{
  "name": "easymd",
  "private": true,
  "version": "1.0.0",
  "description": "EasyMD Markdown Editor",
  "author": "EasyMD",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && npm run extension:zip",
    "preview": "vite preview",
    "extension:zip": "node scripts/package-extension.cjs",
    "electron:dev": "concurrently -k \"cross-env DISABLE_HMR=false vite --port=3000\" \"wait-on tcp:3000 && electron .\"",
    "electron:build": "vite build && electron-builder --win",
    "electron:build:dir": "vite build && electron-builder --win --dir",
    "electron:build:portable": "vite build && electron-builder --win portable"
  },
  "devDependencies": {
    "@bytemd/plugin-gfm": "^1.22.0",
    "@bytemd/plugin-highlight": "^1.22.0",
    "@bytemd/vue-next": "^1.22.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@lucide/vue": "^1.16.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jsdom": "^30.0.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "codemirror": "^6.0.2",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "docx": "^9.7.1",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "highlight.js": "^11.11.1",
    "html-docx-js-typescript": "^0.1.5",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.14.0",
    "jsdom": "^30.0.1",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "katex": "^0.17.0",
    "lucide-vue-next": "^1.0.0",
    "mammoth": "^1.12.0",
    "marked": "^18.0.4",
    "mermaid": "^11.15.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.0.12",
    "vue": "^3.5.34",
    "vue-router": "^4.6.4",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.easymd.app",
    "productName": "EasyMD",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "asar": true,
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NiceMD"
    }
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@tidbcloud/serverless": "^0.3.0"
  }
}
