{
  "name": "easymd",
  "private": true,
  "version": "1.0.0",
  "description": "EasyMD Markdown Editor",
  "author": "EasyMD",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && npm run extension:zip",
    "preview": "vite preview",
    "extension:zip": "node scripts/package-extension.cjs",
    "electron:dev": "concurrently -k \"cross-env DISABLE_HMR=false vite --port=3000\" \"wait-on tcp:3000 && electron .\"",
    "electron:build": "vite build && electron-builder --win",
    "electron:build:dir": "vite build && electron-builder --win --dir",
    "electron:build:portable": "vite build && electron-builder --win portable"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.0.12",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.easymd.app",
    "productName": "EasyMD",
    "npmRebuild": false,
    "nodeGypRebuild": false,
    "asar": true,
    "directories": {
      "output": "dist_electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "NiceMD"
    }
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@lezer/highlight": "^1.2.3",
    "@lucide/vue": "^1.16.0",
    "@neondatabase/serverless": "^1.1.0",
    "@tidbcloud/serverless": "^0.3.0",
    "canvas-confetti": "^1.9.4",
    "codemirror": "^6.0.2",
    "cos-js-sdk-v5": "^1.10.1",
    "docx": "^9.7.1",
    "dompurify": "^3.3.1",
    "highlight.js": "^11.11.1",
    "html2canvas": "^1.4.1",
    "js-md5": "^0.9.2",
    "katex": "^0.17.0",
    "mammoth": "^1.12.0",
    "marked": "^18.0.4",
    "mermaid": "^11.15.0",
    "vue": "^3.5.34"
  }
}
